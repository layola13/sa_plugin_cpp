@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@eq0(a: ptr, n: i32, f: i32) -> i32:
  cpp_t_0 = add f, 0
  fi = cpp_t_0
  cpp_t_1 = mul 0, 4
  cpp_t_2 = add a, cpp_t_1
  cpp_t_3 = load cpp_t_2 + 0 as i32
  cpp_t_4 = eq fi, cpp_t_3
  cpp_tr_5 = 0
  br cpp_t_4 -> L_cpp_tern_0, L_cpp_tere_1
L_cpp_tern_0:
  !cpp_tr_5
  cpp_tr_5 = 1
  jmp L_cpp_term_2
L_cpp_tere_1:
  !cpp_tr_5
  cpp_tr_5 = 0
  jmp L_cpp_term_2
L_cpp_term_2:
  cpp_t_6 = add cpp_tr_5, 0
  !cpp_tr_5
  !fi
  ret cpp_t_6
@main() -> i32:
  t = alloc 4
  cpp_t_7 = add t, 0
  store cpp_t_7 + 0, 5 as i32
  cpp_t_8 = call @eq0(t, 1, 1)
  cpp_t_9 = sext cpp_t_8 as i64
  cpp_t_10 = alloc 64
  cpp_t_11 = alloc 8
  cpp_t_12 = call @sa_fmt_i64_into(cpp_t_9, 10, cpp_t_10, 64, &cpp_t_11)
  cpp_t_13 = load cpp_t_11 + 0 as u64
  cpp_t_14 = alloc 16
  store cpp_t_14 + 0, cpp_t_10 as ptr
  store cpp_t_14 + 8, cpp_t_13 as u64
  cpp_t_15 = load cpp_t_14 + 0 as ptr
  cpp_t_16 = load cpp_t_14 + 8 as u64
  call @sa_print_bytes(&cpp_t_15, cpp_t_16)
  !cpp_t_8
  cpp_t_17 = alloc 16
  store cpp_t_17 + 0, &str_0 as ptr
  store cpp_t_17 + 8, 1 as u64
  cpp_t_18 = load cpp_t_17 + 0 as ptr
  cpp_t_19 = load cpp_t_17 + 8 as u64
  call @sa_print_bytes(&cpp_t_18, cpp_t_19)
  !cpp_t_17
  !cpp_t_14
  !cpp_t_12
  !cpp_t_11
  !cpp_t_10
  !t
  ret 0
