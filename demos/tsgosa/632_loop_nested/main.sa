@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@main() -> i32:
  n = 0
L_cpp_while_0:
  cpp_t_0 = slt n, 2
  br cpp_t_0 -> L_cpp_wbody_1, L_cpp_wend_2
L_cpp_wbody_1:
  i = 0
L_cpp_for_3:
  cpp_t_1 = slt i, 2
  br cpp_t_1 -> L_cpp_fbody_4, L_cpp_fend_6
L_cpp_fbody_4:
  cpp_t_2 = mul n, 10
  cpp_t_3 = add cpp_t_2, i
  cpp_t_4 = sext cpp_t_3 as i64
  cpp_t_5 = alloc 64
  cpp_t_6 = alloc 8
  cpp_t_7 = call @sa_fmt_i64_into(cpp_t_4, 10, cpp_t_5, 64, &cpp_t_6)
  cpp_t_8 = load cpp_t_6 + 0 as u64
  cpp_t_9 = alloc 16
  store cpp_t_9 + 0, cpp_t_5 as ptr
  store cpp_t_9 + 8, cpp_t_8 as u64
  cpp_t_10 = load cpp_t_9 + 0 as ptr
  cpp_t_11 = load cpp_t_9 + 8 as u64
  call @sa_print_bytes(&cpp_t_10, cpp_t_11)
  cpp_t_12 = alloc 16
  store cpp_t_12 + 0, &str_0 as ptr
  store cpp_t_12 + 8, 1 as u64
  cpp_t_13 = load cpp_t_12 + 0 as ptr
  cpp_t_14 = load cpp_t_12 + 8 as u64
  call @sa_print_bytes(&cpp_t_13, cpp_t_14)
  !cpp_t_12
  !cpp_t_9
  !cpp_t_7
  !cpp_t_6
  !cpp_t_5
  jmp L_cpp_fstep_5
L_cpp_fstep_5:
  cpp_t_15 = add i, 1
  !i
  i = cpp_t_15
  jmp L_cpp_for_3
L_cpp_fend_6:
  !i
  cpp_t_16 = add n, 1
  !n
  n = cpp_t_16
  jmp L_cpp_while_0
L_cpp_wend_2:
  !n
  ret 0
