@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@isPrime(n: i32) -> i32:
  cpp_t_0 = slt n, 2
  br cpp_t_0 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  ret 0
L_cpp_endif_1:
  i = 2
L_cpp_for_2:
  cpp_t_1 = mul i, i
  cpp_t_2 = sle cpp_t_1, n
  br cpp_t_2 -> L_cpp_fbody_3, L_cpp_fend_5
L_cpp_fbody_3:
  cpp_t_3 = srem n, i
  cpp_t_4 = eq cpp_t_3, 0
  br cpp_t_4 -> L_cpp_then_6, L_cpp_endif_7
L_cpp_then_6:
  !i
  ret 0
L_cpp_endif_7:
  jmp L_cpp_fstep_4
L_cpp_fstep_4:
  cpp_t_5 = add i, 1
  cpp_t_6 = add i, 0
  i = cpp_t_5
  jmp L_cpp_for_2
L_cpp_fend_5:
  !i
  ret 1
@main() -> i32:
  c = 0
  i = 2
L_cpp_for_8:
  cpp_t_7 = slt i, 30
  br cpp_t_7 -> L_cpp_fbody_9, L_cpp_fend_11
L_cpp_fbody_9:
  cpp_t_8 = call @isPrime(i)
  cpp_t_9 = add c, cpp_t_8
  !cpp_t_8
  !c
  c = cpp_t_9
  jmp L_cpp_fstep_10
L_cpp_fstep_10:
  cpp_t_10 = add i, 1
  cpp_t_11 = add i, 0
  !i
  i = cpp_t_10
  jmp L_cpp_for_8
L_cpp_fend_11:
  !i
  cpp_t_12 = sext c as i64
  cpp_t_13 = alloc 64
  cpp_t_14 = alloc 8
  cpp_t_15 = call @sa_fmt_i64_into(cpp_t_12, 10, cpp_t_13, 64, &cpp_t_14)
  cpp_t_16 = load cpp_t_14 + 0 as u64
  cpp_t_17 = alloc 16
  store cpp_t_17 + 0, cpp_t_13 as ptr
  store cpp_t_17 + 8, cpp_t_16 as u64
  cpp_t_18 = load cpp_t_17 + 0 as ptr
  cpp_t_19 = load cpp_t_17 + 8 as u64
  call @sa_print_bytes(&cpp_t_18, cpp_t_19)
  cpp_t_20 = alloc 16
  store cpp_t_20 + 0, &str_0 as ptr
  store cpp_t_20 + 8, 1 as u64
  cpp_t_21 = load cpp_t_20 + 0 as ptr
  cpp_t_22 = load cpp_t_20 + 8 as u64
  call @sa_print_bytes(&cpp_t_21, cpp_t_22)
  !cpp_t_20
  !cpp_t_17
  !cpp_t_15
  !cpp_t_14
  !cpp_t_13
  !c
  ret 0
