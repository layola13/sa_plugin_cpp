@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:" "
@const str_1 = utf8:"\n"
@gcd(a: i32, b: i32) -> i32:
  cpp_t_0 = eq b, 0
  br cpp_t_0 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  cpp_t_1 = add a, 0
  ret cpp_t_1
L_cpp_endif_1:
  cpp_t_2 = srem a, b
  cpp_t_3 = call @gcd(b, cpp_t_2)
  ret cpp_t_3
@main() -> i32:
  cpp_t_4 = call @gcd(48, 18)
  g = cpp_t_4
  cpp_t_5 = sext g as i64
  cpp_t_6 = alloc 64
  cpp_t_7 = alloc 8
  cpp_t_8 = call @sa_fmt_i64_into(cpp_t_5, 10, cpp_t_6, 64, &cpp_t_7)
  cpp_t_9 = load cpp_t_7 + 0 as u64
  cpp_t_10 = alloc 16
  store cpp_t_10 + 0, cpp_t_6 as ptr
  store cpp_t_10 + 8, cpp_t_9 as u64
  cpp_t_11 = load cpp_t_10 + 0 as ptr
  cpp_t_12 = load cpp_t_10 + 8 as u64
  call @sa_print_bytes(&cpp_t_11, cpp_t_12)
  cpp_t_13 = alloc 16
  store cpp_t_13 + 0, &str_0 as ptr
  store cpp_t_13 + 8, 1 as u64
  cpp_t_14 = load cpp_t_13 + 0 as ptr
  cpp_t_15 = load cpp_t_13 + 8 as u64
  call @sa_print_bytes(&cpp_t_14, cpp_t_15)
  !cpp_t_13
  cpp_t_16 = sdiv 48, g
  cpp_t_17 = mul cpp_t_16, 18
  cpp_t_18 = sext cpp_t_17 as i64
  cpp_t_19 = alloc 64
  cpp_t_20 = alloc 8
  cpp_t_21 = call @sa_fmt_i64_into(cpp_t_18, 10, cpp_t_19, 64, &cpp_t_20)
  cpp_t_22 = load cpp_t_20 + 0 as u64
  cpp_t_23 = alloc 16
  store cpp_t_23 + 0, cpp_t_19 as ptr
  store cpp_t_23 + 8, cpp_t_22 as u64
  cpp_t_24 = load cpp_t_23 + 0 as ptr
  cpp_t_25 = load cpp_t_23 + 8 as u64
  call @sa_print_bytes(&cpp_t_24, cpp_t_25)
  cpp_t_26 = alloc 16
  store cpp_t_26 + 0, &str_1 as ptr
  store cpp_t_26 + 8, 1 as u64
  cpp_t_27 = load cpp_t_26 + 0 as ptr
  cpp_t_28 = load cpp_t_26 + 8 as u64
  call @sa_print_bytes(&cpp_t_27, cpp_t_28)
  !cpp_t_26
  !cpp_t_23
  !cpp_t_21
  !cpp_t_20
  !cpp_t_19
  !cpp_t_10
  !cpp_t_8
  !cpp_t_7
  !cpp_t_6
  !g
  ret 0
