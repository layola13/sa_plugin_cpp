@isLeap(y: i32) -> i32:
  cpp_t_0 = srem y, 400
  cpp_t_1 = eq cpp_t_0, 0
  br cpp_t_1 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  ret 1
L_cpp_endif_1:
  cpp_t_2 = srem y, 100
