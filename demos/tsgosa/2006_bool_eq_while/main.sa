@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@main() -> i32:
  f = 1
  t = 0
L_cpp_while_0:
  cpp_t_0 = eq f, t
  br cpp_t_0 -> L_cpp_wbody_1, L_cpp_wend_2
L_cpp_wbody_1:
  !f
  f = 1
  jmp L_cpp_wend_2
L_cpp_wend_2:
  cpp_t_1 = sext 1 as i64
  cpp_t_2 = alloc 64
  cpp_t_3 = alloc 8
  cpp_t_4 = call @sa_fmt_i64_into(cpp_t_1, 10, cpp_t_2, 64, &cpp_t_3)
  cpp_t_5 = load cpp_t_3 + 0 as u64
  cpp_t_6 = alloc 16
  store cpp_t_6 + 0, cpp_t_2 as ptr
  store cpp_t_6 + 8, cpp_t_5 as u64
  cpp_t_7 = load cpp_t_6 + 0 as ptr
  cpp_t_8 = load cpp_t_6 + 8 as u64
  call @sa_print_bytes(&cpp_t_7, cpp_t_8)
  cpp_t_9 = alloc 16
  store cpp_t_9 + 0, &str_0 as ptr
  store cpp_t_9 + 8, 1 as u64
  cpp_t_10 = load cpp_t_9 + 0 as ptr
  cpp_t_11 = load cpp_t_9 + 8 as u64
  call @sa_print_bytes(&cpp_t_10, cpp_t_11)
  !cpp_t_9
  !cpp_t_6
  !cpp_t_4
  !cpp_t_3
  !cpp_t_2
  !t
