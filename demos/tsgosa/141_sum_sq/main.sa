  jmp L_cpp_fstep_2
L_cpp_fstep_2:
  cpp_t_3 = add i, 1
  cpp_t_4 = add i, 0
  !i
  i = cpp_t_3
  jmp L_cpp_for_0
L_cpp_fend_3:
  !i
  cpp_t_5 = sext t as i64
  cpp_t_6 = alloc 64
  cpp_t_7 = alloc 8
  cpp_t_8 = call @sa_fmt_i64_into(cpp_t_5, 10, cpp_t_6, 64, &cpp_t_7)
