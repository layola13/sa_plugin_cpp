@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@main() -> i32:
  n = 0
  i = 1
L_cpp_for_0:
  cpp_t_0 = sle i, 20
  br cpp_t_0 -> L_cpp_fbody_1, L_cpp_fend_3
L_cpp_fbody_1:
  cpp_t_1 = srem i, 3
  cpp_t_2 = eq cpp_t_1, 0
  cpp_t_3 = srem i, 5
  cpp_t_4 = eq cpp_t_3, 0
  cpp_t_5 = or cpp_t_2, cpp_t_4
  br cpp_t_5 -> L_cpp_then_4, L_cpp_endif_5
L_cpp_then_4:
  cpp_t_6 = add n, 1
  !n
  n = cpp_t_6
  jmp L_cpp_endif_5
L_cpp_endif_5:
  jmp L_cpp_fstep_2
L_cpp_fstep_2:
  cpp_t_7 = add i, 1
  cpp_t_8 = add i, 0
  !i
  i = cpp_t_7
  jmp L_cpp_for_0
L_cpp_fend_3:
  !i
  cpp_t_9 = sext n as i64
  cpp_t_10 = alloc 64
  cpp_t_11 = alloc 8
  cpp_t_12 = call @sa_fmt_i64_into(cpp_t_9, 10, cpp_t_10, 64, &cpp_t_11)
  cpp_t_13 = load cpp_t_11 + 0 as u64
  cpp_t_14 = alloc 16
  store cpp_t_14 + 0, cpp_t_10 as ptr
  store cpp_t_14 + 8, cpp_t_13 as u64
  cpp_t_15 = load cpp_t_14 + 0 as ptr
  cpp_t_16 = load cpp_t_14 + 8 as u64
  call @sa_print_bytes(&cpp_t_15, cpp_t_16)
  cpp_t_17 = alloc 16
  store cpp_t_17 + 0, &str_0 as ptr
  store cpp_t_17 + 8, 1 as u64
  cpp_t_18 = load cpp_t_17 + 0 as ptr
  cpp_t_19 = load cpp_t_17 + 8 as u64
  call @sa_print_bytes(&cpp_t_18, cpp_t_19)
  !cpp_t_17
  !cpp_t_14
  !cpp_t_12
  !cpp_t_11
  !cpp_t_10
  !n
  ret 0
