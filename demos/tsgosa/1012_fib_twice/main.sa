@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@fib(n: i32) -> i32:
  cpp_t_0 = sle n, 1
  br cpp_t_0 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  cpp_t_1 = add n, 0
  ret cpp_t_1
L_cpp_endif_1:
  cpp_t_2 = sub n, 1
  cpp_t_3 = call @fib(cpp_t_2)
  cpp_t_4 = sub n, 2
  cpp_t_5 = call @fib(cpp_t_4)
  cpp_t_6 = add cpp_t_3, cpp_t_5
  !cpp_t_3
  !cpp_t_5
  ret cpp_t_6
@main() -> i32:
  cpp_t_7 = call @fib(10)
  cpp_t_8 = sext cpp_t_7 as i64
  cpp_t_9 = alloc 64
  cpp_t_10 = alloc 8
  cpp_t_11 = call @sa_fmt_i64_into(cpp_t_8, 10, cpp_t_9, 64, &cpp_t_10)
  cpp_t_12 = load cpp_t_10 + 0 as u64
  cpp_t_13 = alloc 16
  store cpp_t_13 + 0, cpp_t_9 as ptr
  store cpp_t_13 + 8, cpp_t_12 as u64
  cpp_t_14 = load cpp_t_13 + 0 as ptr
  cpp_t_15 = load cpp_t_13 + 8 as u64
  call @sa_print_bytes(&cpp_t_14, cpp_t_15)
  !cpp_t_7
  cpp_t_16 = alloc 16
  store cpp_t_16 + 0, &str_0 as ptr
  store cpp_t_16 + 8, 1 as u64
  cpp_t_17 = load cpp_t_16 + 0 as ptr
  cpp_t_18 = load cpp_t_16 + 8 as u64
  call @sa_print_bytes(&cpp_t_17, cpp_t_18)
  cpp_t_19 = call @fib(8)
  cpp_t_20 = sext cpp_t_19 as i64
  cpp_t_21 = alloc 64
  cpp_t_22 = alloc 8
  cpp_t_23 = call @sa_fmt_i64_into(cpp_t_20, 10, cpp_t_21, 64, &cpp_t_22)
  cpp_t_24 = load cpp_t_22 + 0 as u64
  cpp_t_25 = alloc 16
  store cpp_t_25 + 0, cpp_t_21 as ptr
  store cpp_t_25 + 8, cpp_t_24 as u64
  cpp_t_26 = load cpp_t_25 + 0 as ptr
  cpp_t_27 = load cpp_t_25 + 8 as u64
  call @sa_print_bytes(&cpp_t_26, cpp_t_27)
  !cpp_t_19
  cpp_t_28 = alloc 16
  store cpp_t_28 + 0, &str_0 as ptr
  store cpp_t_28 + 8, 1 as u64
  cpp_t_29 = load cpp_t_28 + 0 as ptr
  cpp_t_30 = load cpp_t_28 + 8 as u64
  call @sa_print_bytes(&cpp_t_29, cpp_t_30)
  !cpp_t_28
  !cpp_t_25
  !cpp_t_23
  !cpp_t_22
  !cpp_t_21
  !cpp_t_16
  !cpp_t_13
  !cpp_t_11
  !cpp_t_10
  !cpp_t_9
  ret 0
