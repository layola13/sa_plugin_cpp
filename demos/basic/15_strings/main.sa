@import "sa_std/io/print.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"hello"
@const str_1 = utf8:"\n"
@const str_2 = utf8:"world"
@const str_3 = utf8:"a"
@const str_4 = utf8:" "
@const str_5 = utf8:"b"
@main() -> i32:
  cpp_t_0 = alloc 16
  store cpp_t_0 + 0, &str_0 as ptr
  store cpp_t_0 + 8, 5 as u64
  cpp_t_1 = load cpp_t_0 + 0 as ptr
  cpp_t_2 = load cpp_t_0 + 8 as u64
  call @sa_print_bytes(&cpp_t_1, cpp_t_2)
  !cpp_t_0
  cpp_t_3 = alloc 16
  store cpp_t_3 + 0, &str_1 as ptr
  store cpp_t_3 + 8, 1 as u64
  cpp_t_4 = load cpp_t_3 + 0 as ptr
  cpp_t_5 = load cpp_t_3 + 8 as u64
  call @sa_print_bytes(&cpp_t_4, cpp_t_5)
  cpp_t_6 = alloc 16
  store cpp_t_6 + 0, &str_2 as ptr
  store cpp_t_6 + 8, 5 as u64
  name = cpp_t_6
  cpp_t_7 = load name + 0 as ptr
  cpp_t_8 = load name + 8 as u64
  call @sa_print_bytes(&cpp_t_7, cpp_t_8)
  cpp_t_9 = alloc 16
  store cpp_t_9 + 0, &str_1 as ptr
  store cpp_t_9 + 8, 1 as u64
  cpp_t_10 = load cpp_t_9 + 0 as ptr
  cpp_t_11 = load cpp_t_9 + 8 as u64
  call @sa_print_bytes(&cpp_t_10, cpp_t_11)
  cpp_t_12 = alloc 16
  store cpp_t_12 + 0, &str_3 as ptr
  store cpp_t_12 + 8, 1 as u64
  cpp_t_13 = load cpp_t_12 + 0 as ptr
  cpp_t_14 = load cpp_t_12 + 8 as u64
  call @sa_print_bytes(&cpp_t_13, cpp_t_14)
  !cpp_t_12
  cpp_t_15 = alloc 16
  store cpp_t_15 + 0, &str_4 as ptr
  store cpp_t_15 + 8, 1 as u64
  cpp_t_16 = load cpp_t_15 + 0 as ptr
  cpp_t_17 = load cpp_t_15 + 8 as u64
  call @sa_print_bytes(&cpp_t_16, cpp_t_17)
  !cpp_t_15
  cpp_t_18 = alloc 16
  store cpp_t_18 + 0, &str_5 as ptr
  store cpp_t_18 + 8, 1 as u64
  cpp_t_19 = load cpp_t_18 + 0 as ptr
  cpp_t_20 = load cpp_t_18 + 8 as u64
  call @sa_print_bytes(&cpp_t_19, cpp_t_20)
  !cpp_t_18
  cpp_t_21 = alloc 16
  store cpp_t_21 + 0, &str_1 as ptr
  store cpp_t_21 + 8, 1 as u64
  cpp_t_22 = load cpp_t_21 + 0 as ptr
  cpp_t_23 = load cpp_t_21 + 8 as u64
  call @sa_print_bytes(&cpp_t_22, cpp_t_23)
  !cpp_t_21
  !cpp_t_9
  !cpp_t_3
  !name
  ret 0
