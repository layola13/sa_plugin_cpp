  cpp_t_0 = sle i, 5
  br cpp_t_0 -> L_cpp_fbody_1, L_cpp_fend_3
L_cpp_fbody_1:
  cpp_t_1 = mul i, i
  cpp_t_2 = add t, cpp_t_1
  !t
