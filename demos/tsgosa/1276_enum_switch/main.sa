L_cpp_swnext_3:
  jmp L_cpp_case_1_2
L_cpp_swnext_4:
  jmp L_cpp_swend_0
L_cpp_case_1_0:
  !cpp_sw_0
  ret 1
L_cpp_case_1_1:
  ret 2
L_cpp_case_1_2:
  ret 3
L_cpp_swend_0:
  ret 3
@main() -> i32:
  cpp_t_4 = call @pick(0)
  cpp_t_5 = sext cpp_t_4 as i64
  cpp_t_6 = alloc 64
  cpp_t_7 = alloc 8
  cpp_t_8 = call @sa_fmt_i64_into(cpp_t_5, 10, cpp_t_6, 64, &cpp_t_7)
  cpp_t_9 = load cpp_t_7 + 0 as u64
  cpp_t_10 = alloc 16
  store cpp_t_10 + 0, cpp_t_6 as ptr
  store cpp_t_10 + 8, cpp_t_9 as u64
  cpp_t_11 = load cpp_t_10 + 0 as ptr
  cpp_t_12 = load cpp_t_10 + 8 as u64
  call @sa_print_bytes(&cpp_t_11, cpp_t_12)
  !cpp_t_4
  cpp_t_13 = alloc 16
  store cpp_t_13 + 0, &str_0 as ptr
  store cpp_t_13 + 8, 1 as u64
  cpp_t_14 = load cpp_t_13 + 0 as ptr
  cpp_t_15 = load cpp_t_13 + 8 as u64
  call @sa_print_bytes(&cpp_t_14, cpp_t_15)
  cpp_t_16 = call @pick(2)
  cpp_t_17 = sext cpp_t_16 as i64
  cpp_t_18 = alloc 64
  cpp_t_19 = alloc 8
  cpp_t_20 = call @sa_fmt_i64_into(cpp_t_17, 10, cpp_t_18, 64, &cpp_t_19)
  cpp_t_21 = load cpp_t_19 + 0 as u64
  cpp_t_22 = alloc 16
  store cpp_t_22 + 0, cpp_t_18 as ptr
  store cpp_t_22 + 8, cpp_t_21 as u64
  cpp_t_23 = load cpp_t_22 + 0 as ptr
  cpp_t_24 = load cpp_t_22 + 8 as u64
  call @sa_print_bytes(&cpp_t_23, cpp_t_24)
  !cpp_t_16
  cpp_t_25 = alloc 16
  store cpp_t_25 + 0, &str_0 as ptr
  store cpp_t_25 + 8, 1 as u64
  cpp_t_26 = load cpp_t_25 + 0 as ptr
  cpp_t_27 = load cpp_t_25 + 8 as u64
  call @sa_print_bytes(&cpp_t_26, cpp_t_27)
  !cpp_t_25
  !cpp_t_22
  !cpp_t_20
  !cpp_t_19
  !cpp_t_18
  !cpp_t_13
  !cpp_t_10
  !cpp_t_8
