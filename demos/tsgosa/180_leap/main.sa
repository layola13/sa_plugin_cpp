  store cpp_t_15 + 8, 1 as u64
  cpp_t_16 = load cpp_t_15 + 0 as ptr
  cpp_t_17 = load cpp_t_15 + 8 as u64
  call @sa_print_bytes(&cpp_t_16, cpp_t_17)
  !cpp_t_15
