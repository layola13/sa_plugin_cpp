@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@main() -> i32:
  f = 0
  cpp_t_0 = or f, 1
  g = cpp_t_0
  cpp_tr_1 = 0
  br g -> L_cpp_tern_0, L_cpp_tere_1
L_cpp_tern_0:
  !cpp_tr_1
  cpp_tr_1 = 1
  jmp L_cpp_term_2
L_cpp_tere_1:
  !cpp_tr_1
  cpp_tr_1 = 0
  jmp L_cpp_term_2
L_cpp_term_2:
  cpp_t_2 = add cpp_tr_1, 0
  !cpp_tr_1
  cpp_t_3 = sext cpp_t_2 as i64
  cpp_t_4 = alloc 64
  cpp_t_5 = alloc 8
  cpp_t_6 = call @sa_fmt_i64_into(cpp_t_3, 10, cpp_t_4, 64, &cpp_t_5)
  cpp_t_7 = load cpp_t_5 + 0 as u64
  cpp_t_8 = alloc 16
  store cpp_t_8 + 0, cpp_t_4 as ptr
  store cpp_t_8 + 8, cpp_t_7 as u64
  cpp_t_9 = load cpp_t_8 + 0 as ptr
  cpp_t_10 = load cpp_t_8 + 8 as u64
  call @sa_print_bytes(&cpp_t_9, cpp_t_10)
  cpp_t_11 = alloc 16
  store cpp_t_11 + 0, &str_0 as ptr
  store cpp_t_11 + 8, 1 as u64
  cpp_t_12 = load cpp_t_11 + 0 as ptr
  cpp_t_13 = load cpp_t_11 + 8 as u64
  call @sa_print_bytes(&cpp_t_12, cpp_t_13)
  !cpp_t_11
  !cpp_t_8
  !cpp_t_6
  !cpp_t_5
  !cpp_t_4
  !g
  !f
