  store cpp_t_0 + 0, 4 as i32
  cpp_t_0 = add o, 4
  store cpp_t_0 + 0, 5 as i32
  cpp_t_0 = add o, 8
  store cpp_t_0 + 0, 6 as i32
  cpp_t_1 = mul 1, 4
  cpp_t_2 = add o, cpp_t_1
  cpp_t_3 = load cpp_t_2 + 0 as i32
  cpp_t_4 = mul cpp_t_3, 10
  cpp_t_5 = sext cpp_t_4 as i64
  cpp_t_6 = alloc 64
  cpp_t_7 = alloc 8
  cpp_t_8 = call @sa_fmt_i64_into(cpp_t_5, 10, cpp_t_6, 64, &cpp_t_7)
  cpp_t_9 = load cpp_t_7 + 0 as u64
  cpp_t_10 = alloc 16
  store cpp_t_10 + 0, cpp_t_6 as ptr
