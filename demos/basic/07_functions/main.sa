@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@add3(a: i32, b: i32, c: i32) -> i32:
  cpp_t_0 = add a, b
  cpp_t_1 = add cpp_t_0, c
  ret cpp_t_1
@fact(n: i32) -> i32:
  cpp_t_2 = sle n, 1
  br cpp_t_2 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  ret 1
L_cpp_endif_1:
  cpp_t_3 = sub n, 1
  cpp_t_4 = call @fact(cpp_t_3)
  cpp_t_5 = mul n, cpp_t_4
  !cpp_t_4
  ret cpp_t_5
@main() -> i32:
  cpp_t_6 = call @add3(1, 2, 3)
  cpp_t_7 = sext cpp_t_6 as i64
  cpp_t_8 = alloc 64
  cpp_t_9 = alloc 8
  cpp_t_10 = call @sa_fmt_i64_into(cpp_t_7, 10, cpp_t_8, 64, &cpp_t_9)
  cpp_t_11 = load cpp_t_9 + 0 as u64
  cpp_t_12 = alloc 16
  store cpp_t_12 + 0, cpp_t_8 as ptr
  store cpp_t_12 + 8, cpp_t_11 as u64
  cpp_t_13 = load cpp_t_12 + 0 as ptr
  cpp_t_14 = load cpp_t_12 + 8 as u64
  call @sa_print_bytes(&cpp_t_13, cpp_t_14)
  !cpp_t_6
  cpp_t_15 = alloc 16
  store cpp_t_15 + 0, &str_0 as ptr
  store cpp_t_15 + 8, 1 as u64
  cpp_t_16 = load cpp_t_15 + 0 as ptr
  cpp_t_17 = load cpp_t_15 + 8 as u64
  call @sa_print_bytes(&cpp_t_16, cpp_t_17)
  cpp_t_18 = call @fact(6)
  cpp_t_19 = sext cpp_t_18 as i64
  cpp_t_20 = alloc 64
  cpp_t_21 = alloc 8
  cpp_t_22 = call @sa_fmt_i64_into(cpp_t_19, 10, cpp_t_20, 64, &cpp_t_21)
  cpp_t_23 = load cpp_t_21 + 0 as u64
  cpp_t_24 = alloc 16
  store cpp_t_24 + 0, cpp_t_20 as ptr
  store cpp_t_24 + 8, cpp_t_23 as u64
  cpp_t_25 = load cpp_t_24 + 0 as ptr
  cpp_t_26 = load cpp_t_24 + 8 as u64
  call @sa_print_bytes(&cpp_t_25, cpp_t_26)
  !cpp_t_18
  cpp_t_27 = alloc 16
  store cpp_t_27 + 0, &str_0 as ptr
  store cpp_t_27 + 8, 1 as u64
  cpp_t_28 = load cpp_t_27 + 0 as ptr
  cpp_t_29 = load cpp_t_27 + 8 as u64
  call @sa_print_bytes(&cpp_t_28, cpp_t_29)
  !cpp_t_27
  !cpp_t_24
  !cpp_t_22
  !cpp_t_21
  !cpp_t_20
  !cpp_t_15
  !cpp_t_12
  !cpp_t_10
  !cpp_t_9
  !cpp_t_8
  ret 0
