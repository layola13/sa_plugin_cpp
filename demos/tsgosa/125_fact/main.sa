@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@fact(n: i32) -> i32:
  cpp_t_0 = sle n, 1
  br cpp_t_0 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  ret 1
L_cpp_endif_1:
  cpp_t_1 = sub n, 1
  cpp_t_2 = call @fact(cpp_t_1)
  cpp_t_3 = mul n, cpp_t_2
  !cpp_t_2
  ret cpp_t_3
@main() -> i32:
  cpp_t_4 = call @fact(5)
  cpp_t_5 = sext cpp_t_4 as i64
  cpp_t_6 = alloc 64
  cpp_t_7 = alloc 8
  cpp_t_8 = call @sa_fmt_i64_into(cpp_t_5, 10, cpp_t_6, 64, &cpp_t_7)
  cpp_t_9 = load cpp_t_7 + 0 as u64
  cpp_t_10 = alloc 16
  store cpp_t_10 + 0, cpp_t_6 as ptr
  store cpp_t_10 + 8, cpp_t_9 as u64
  cpp_t_11 = load cpp_t_10 + 0 as ptr
  cpp_t_12 = load cpp_t_10 + 8 as u64
  call @sa_print_bytes(&cpp_t_11, cpp_t_12)
  !cpp_t_4
  cpp_t_13 = alloc 16
  store cpp_t_13 + 0, &str_0 as ptr
  store cpp_t_13 + 8, 1 as u64
  cpp_t_14 = load cpp_t_13 + 0 as ptr
  cpp_t_15 = load cpp_t_13 + 8 as u64
  call @sa_print_bytes(&cpp_t_14, cpp_t_15)
  !cpp_t_13
  !cpp_t_10
  !cpp_t_8
  !cpp_t_7
  !cpp_t_6
  ret 0
