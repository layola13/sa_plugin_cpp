@import "sa_std/io/print.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"even"
@const str_1 = utf8:"odd"
@const str_2 = utf8:"\n"
@main() -> i32:
  x = 7
  cpp_t_0 = srem x, 2
  cpp_t_1 = eq cpp_t_0, 0
  cpp_tr_2 = 0
  br cpp_t_1 -> L_cpp_tern_0, L_cpp_tere_1
L_cpp_tern_0:
  cpp_t_3 = alloc 16
  store cpp_t_3 + 0, &str_0 as ptr
  store cpp_t_3 + 8, 4 as u64
  !cpp_tr_2
  cpp_tr_2 = cpp_t_3
  jmp L_cpp_term_2
L_cpp_tere_1:
  cpp_t_4 = alloc 16
  store cpp_t_4 + 0, &str_1 as ptr
  store cpp_t_4 + 8, 3 as u64
  !cpp_tr_2
  cpp_tr_2 = cpp_t_4
  jmp L_cpp_term_2
L_cpp_term_2:
  cpp_t_5 = load cpp_tr_2 + 0 as ptr
  cpp_t_6 = load cpp_tr_2 + 8 as u64
  call @sa_print_bytes(&cpp_t_5, cpp_t_6)
  cpp_t_7 = alloc 16
  store cpp_t_7 + 0, &str_2 as ptr
  store cpp_t_7 + 8, 1 as u64
  cpp_t_8 = load cpp_t_7 + 0 as ptr
  cpp_t_9 = load cpp_t_7 + 8 as u64
  call @sa_print_bytes(&cpp_t_8, cpp_t_9)
  !cpp_t_7
  !cpp_tr_2
  !x
  ret 0
