  store cpp_t_13 + 8, 1 as u64
  cpp_t_14 = load cpp_t_13 + 0 as ptr
  cpp_t_15 = load cpp_t_13 + 8 as u64
  call @sa_print_bytes(&cpp_t_14, cpp_t_15)
  !cpp_t_13
  !cpp_t_10
  !cpp_t_8
  !cpp_t_7
  !cpp_t_6
