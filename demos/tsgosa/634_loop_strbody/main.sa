@import "sa_std/io/print.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"x"
@const str_1 = utf8:"\n"
@main() -> i32:
  n = 0
L_cpp_while_0:
  cpp_t_0 = slt n, 2
  br cpp_t_0 -> L_cpp_wbody_1, L_cpp_wend_2
L_cpp_wbody_1:
  cpp_t_1 = alloc 16
  store cpp_t_1 + 0, &str_0 as ptr
  store cpp_t_1 + 8, 1 as u64
  q = cpp_t_1
  cpp_t_2 = load q + 0 as ptr
  cpp_t_3 = load q + 8 as u64
  call @sa_print_bytes(&cpp_t_2, cpp_t_3)
  cpp_t_4 = alloc 16
  store cpp_t_4 + 0, &str_1 as ptr
  store cpp_t_4 + 8, 1 as u64
  cpp_t_5 = load cpp_t_4 + 0 as ptr
  cpp_t_6 = load cpp_t_4 + 8 as u64
  call @sa_print_bytes(&cpp_t_5, cpp_t_6)
  cpp_t_7 = add n, 1
  !n
  n = cpp_t_7
  !cpp_t_4
  !q
  jmp L_cpp_while_0
L_cpp_wend_2:
  !n
  ret 0
