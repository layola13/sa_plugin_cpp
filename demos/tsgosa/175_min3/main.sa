@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@min3(a: i32, b: i32, c: i32) -> i32:
  cpp_t_0 = add a, 0
  m = cpp_t_0
  cpp_t_1 = slt b, m
  br cpp_t_1 -> L_cpp_then_0, L_cpp_endif_1
L_cpp_then_0:
  !m
  cpp_t_2 = add b, 0
  m = cpp_t_2
  jmp L_cpp_endif_1
L_cpp_endif_1:
  cpp_t_3 = slt c, m
  br cpp_t_3 -> L_cpp_then_2, L_cpp_endif_3
L_cpp_then_2:
  !m
  cpp_t_4 = add c, 0
  m = cpp_t_4
  jmp L_cpp_endif_3
L_cpp_endif_3:
  cpp_t_5 = add m, 0
  !m
  ret cpp_t_5
@main() -> i32:
  cpp_t_6 = call @min3(3, 1, 2)
  cpp_t_7 = sext cpp_t_6 as i64
  cpp_t_8 = alloc 64
  cpp_t_9 = alloc 8
  cpp_t_10 = call @sa_fmt_i64_into(cpp_t_7, 10, cpp_t_8, 64, &cpp_t_9)
  cpp_t_11 = load cpp_t_9 + 0 as u64
  cpp_t_12 = alloc 16
  store cpp_t_12 + 0, cpp_t_8 as ptr
  store cpp_t_12 + 8, cpp_t_11 as u64
  cpp_t_13 = load cpp_t_12 + 0 as ptr
  cpp_t_14 = load cpp_t_12 + 8 as u64
  call @sa_print_bytes(&cpp_t_13, cpp_t_14)
  !cpp_t_6
  cpp_t_15 = alloc 16
  store cpp_t_15 + 0, &str_0 as ptr
  store cpp_t_15 + 8, 1 as u64
  cpp_t_16 = load cpp_t_15 + 0 as ptr
  cpp_t_17 = load cpp_t_15 + 8 as u64
  call @sa_print_bytes(&cpp_t_16, cpp_t_17)
  !cpp_t_15
  !cpp_t_12
  !cpp_t_10
  !cpp_t_9
  !cpp_t_8
  ret 0
