  store cpp_t_12 + 8, cpp_t_11 as u64
  cpp_t_13 = load cpp_t_12 + 0 as ptr
  cpp_t_14 = load cpp_t_12 + 8 as u64
  call @sa_print_bytes(&cpp_t_13, cpp_t_14)
  !cpp_t_6
