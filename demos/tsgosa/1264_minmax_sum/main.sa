@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@min(a: i32, b: i32) -> i32:
  cpp_t_0 = slt a, b
  cpp_tr_1 = 0
  br cpp_t_0 -> L_cpp_tern_0, L_cpp_tere_1
L_cpp_tern_0:
  !cpp_tr_1
  cpp_t_2 = add a, 0
  cpp_tr_1 = cpp_t_2
  jmp L_cpp_term_2
L_cpp_tere_1:
  !cpp_tr_1
  cpp_t_3 = add b, 0
  cpp_tr_1 = cpp_t_3
  jmp L_cpp_term_2
L_cpp_term_2:
  cpp_t_4 = add cpp_tr_1, 0
  !cpp_tr_1
  ret cpp_t_4
@max(a: i32, b: i32) -> i32:
  cpp_t_5 = sgt a, b
  cpp_tr_6 = 0
  br cpp_t_5 -> L_cpp_tern_3, L_cpp_tere_4
L_cpp_tern_3:
  !cpp_tr_6
  cpp_t_7 = add a, 0
  cpp_tr_6 = cpp_t_7
  jmp L_cpp_term_5
L_cpp_tere_4:
  !cpp_tr_6
  cpp_t_8 = add b, 0
  cpp_tr_6 = cpp_t_8
  jmp L_cpp_term_5
L_cpp_term_5:
  cpp_t_9 = add cpp_tr_6, 0
  !cpp_tr_6
  ret cpp_t_9
@main() -> i32:
  cpp_t_10 = call @min(3, 7)
  cpp_t_11 = call @max(3, 7)
  cpp_t_12 = add cpp_t_10, cpp_t_11
  !cpp_t_10
  !cpp_t_11
  cpp_t_13 = sext cpp_t_12 as i64
  cpp_t_14 = alloc 64
  cpp_t_15 = alloc 8
  cpp_t_16 = call @sa_fmt_i64_into(cpp_t_13, 10, cpp_t_14, 64, &cpp_t_15)
  cpp_t_17 = load cpp_t_15 + 0 as u64
  cpp_t_18 = alloc 16
  store cpp_t_18 + 0, cpp_t_14 as ptr
  store cpp_t_18 + 8, cpp_t_17 as u64
  cpp_t_19 = load cpp_t_18 + 0 as ptr
  cpp_t_20 = load cpp_t_18 + 8 as u64
  call @sa_print_bytes(&cpp_t_19, cpp_t_20)
  cpp_t_21 = alloc 16
  store cpp_t_21 + 0, &str_0 as ptr
  store cpp_t_21 + 8, 1 as u64
  cpp_t_22 = load cpp_t_21 + 0 as ptr
  cpp_t_23 = load cpp_t_21 + 8 as u64
  call @sa_print_bytes(&cpp_t_22, cpp_t_23)
  !cpp_t_21
  !cpp_t_18
  !cpp_t_16
  !cpp_t_15
  !cpp_t_14
  ret 0
