@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"\n"
@Acc_add(this: ptr, x: i32):
  cpp_t_0 = load this + 0 as i32
  cpp_t_1 = add cpp_t_0, x
  store this + 0, cpp_t_1 as i32
  ret
@Acc_value(this: ptr) -> i32:
  cpp_t_2 = load this + 0 as i32
  ret cpp_t_2
@sum_to(n: i32) -> i32:
  acc = alloc 4
  store acc + 0, 0 as i32
  i = 1
L_cpp_for_0:
  cpp_t_3 = sle i, n
  br cpp_t_3 -> L_cpp_fbody_1, L_cpp_fend_3
L_cpp_fbody_1:
  call @Acc_add(acc, i)
  jmp L_cpp_fstep_2
L_cpp_fstep_2:
  cpp_t_4 = add i, 1
  cpp_t_5 = add i, 0
  !i
  i = cpp_t_4
  jmp L_cpp_for_0
L_cpp_fend_3:
  cpp_t_6 = call @Acc_value(acc)
  !acc
