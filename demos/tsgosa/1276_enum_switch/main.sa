  cpp_sw_0 = cpp_t_1
  cpp_t_2 = eq cpp_sw_0, 0
  br cpp_t_2 -> L_cpp_case_1_0, L_cpp_swnext_2
L_cpp_swnext_2:
  cpp_t_3 = eq cpp_sw_0, 1
