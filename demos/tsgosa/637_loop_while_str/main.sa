@import "sa_std/io/print.sai"
@import "sa_std/fmt.sai"
@import "sa_std/string.sai"
@const str_0 = utf8:"hi"
@const str_1 = utf8:"\n"
@main() -> i32:
  cpp_t_0 = alloc 16
  store cpp_t_0 + 0, &str_0 as ptr
  store cpp_t_0 + 8, 2 as u64
  s = cpp_t_0
  n = 3
L_cpp_while_0:
  br n -> L_cpp_wbody_1, L_cpp_wend_2
L_cpp_wbody_1:
  cpp_t_1 = sext n as i64
  cpp_t_2 = alloc 64
  cpp_t_3 = alloc 8
  cpp_t_4 = call @sa_fmt_i64_into(cpp_t_1, 10, cpp_t_2, 64, &cpp_t_3)
  cpp_t_5 = load cpp_t_3 + 0 as u64
  cpp_t_6 = alloc 16
  store cpp_t_6 + 0, cpp_t_2 as ptr
  store cpp_t_6 + 8, cpp_t_5 as u64
  cpp_t_7 = load cpp_t_6 + 0 as ptr
  cpp_t_8 = load cpp_t_6 + 8 as u64
  call @sa_print_bytes(&cpp_t_7, cpp_t_8)
  cpp_t_9 = alloc 16
  store cpp_t_9 + 0, &str_1 as ptr
  store cpp_t_9 + 8, 1 as u64
  cpp_t_10 = load cpp_t_9 + 0 as ptr
  cpp_t_11 = load cpp_t_9 + 8 as u64
  call @sa_print_bytes(&cpp_t_10, cpp_t_11)
  cpp_t_12 = sub n, 1
  !n
  n = cpp_t_12
  jmp L_cpp_while_0
L_cpp_wend_2:
  cpp_t_13 = sext 2 as i64
  cpp_t_14 = alloc 64
  cpp_t_15 = alloc 8
  cpp_t_16 = call @sa_fmt_i64_into(cpp_t_13, 10, cpp_t_14, 64, &cpp_t_15)
  cpp_t_17 = load cpp_t_15 + 0 as u64
  cpp_t_18 = alloc 16
  store cpp_t_18 + 0, cpp_t_14 as ptr
  store cpp_t_18 + 8, cpp_t_17 as u64
  cpp_t_19 = load cpp_t_18 + 0 as ptr
  cpp_t_20 = load cpp_t_18 + 8 as u64
  call @sa_print_bytes(&cpp_t_19, cpp_t_20)
  cpp_t_21 = alloc 16
  store cpp_t_21 + 0, &str_1 as ptr
  store cpp_t_21 + 8, 1 as u64
  cpp_t_22 = load cpp_t_21 + 0 as ptr
  cpp_t_23 = load cpp_t_21 + 8 as u64
  call @sa_print_bytes(&cpp_t_22, cpp_t_23)
  !cpp_t_21
  !cpp_t_18
  !cpp_t_16
  !cpp_t_15
  !cpp_t_14
  !n
  !s
  ret 0
